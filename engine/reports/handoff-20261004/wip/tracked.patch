+        a if a == abilities::MOTOR_DRIVE => Some((Type::Electric, 4, 1)),
+        a if a == abilities::SAP_SIPPER => Some((Type::Grass, 0, 1)),
+        a if a == abilities::WELL_BAKED_BODY => Some((Type::Fire, 1, 2)),
+        _ => None,
+    };
