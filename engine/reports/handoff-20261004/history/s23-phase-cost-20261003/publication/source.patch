+                .map_err(|e| e.to_string())?;
+        if positions.len() != 1 {
+            return Err("ambiguous root".into());
+        }
+        worlds.push(EngineWorld {
+            id: string(w, "id")?.into(),
+            weight: w["weight"].as_f64().ok_or("weight")?,
+            position: Position {
