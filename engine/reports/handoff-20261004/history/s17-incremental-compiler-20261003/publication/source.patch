+path = "src/lib.rs"
+
+# The library depends on lab-engine only. The `lab-plan` binary needs the scenario loader
+# (serde); it sits behind the default `cli` feature so hot-path users can turn it off with
+# `default-features = false`.
+[features]
+experiment-incremental-compilation = ["experiment-owned-transitions"]
+experiment-shared-final-passes = ["experiment-owned-transitions"]
+experiment-owned-transitions = ["experiment-belief-workspace", "lab-engine/experiment-owned-endings"]
+experiment-owned-transitions-observer = ["experiment-owned-transitions", "lab-engine/experiment-leaf-ending-observer"]
+default = ["cli"]
+experiment-bayesian-cfr = ["experiment-budgeted-search"]
+experiment-public-belief = ["experiment-bayesian-cfr"]
+experiment-growing-belief = ["experiment-public-belief"]
+experiment-belief-workspace = ["experiment-growing-belief"]
+experiment-budgeted-search = []
+experiment-response-sweeps = ["experiment-budgeted-search"]
+experiment-search-quality = ["experiment-budgeted-search", "cli"]
+experiment-prepared-turn = ["lab-engine/experiment-prepared-turn"]
+experiment-prepared-turn-observe = ["experiment-prepared-turn", "lab-engine/experiment-prepared-turn-observe"]
+# `node`: positions stepped by choice strings over the scenario loader (the Python API's core,
+# `engine/py`).
+scenario = ["lab-scenario", "serde_json"]
+cli = ["scenario"]
+# P9 only: read completed flat turn endings at Next::Depth(0).
+experiment-leaf-ending-states = ["lab-engine/experiment-leaf-ending-states"]
+experiment-leaf-ending-observer = ["experiment-leaf-ending-states", "lab-engine/experiment-leaf-ending-observer"]
+# P13 runtime and observer are independently opt-in so OFF/ON captures can be audited.
+experiment-borrowed-child-keys = ["lab-engine/experiment-borrowed-child-keys"]
+experiment-borrowed-child-keys-observer = []
+
+[dependencies]
+lab-engine = { path = "../core" }
+lab-scenario = { path = "../scenario", optional = true }
+# The worker pool of the payoff matrices and child batches (board S24p).
+rayon = "1.10"
+serde_json = { version = "1", optional = true }
+
+[dev-dependencies]
+lab-scenario = { path = "../scenario" }
+serde_json = "1"
+
+[[bin]]
+name = "lab-plan"
+path = "src/bin/lab-plan.rs"
+required-features = ["cli"]
+
+[[bin]]
+name = "lab-rollout"
+path = "src/bin/lab-rollout.rs"
+required-features = ["cli"]
+
+[[bin]]
+name = "lab-parity"
+path = "src/bin/lab-parity.rs"
+required-features = ["cli"]
+
+[[bin]]
+name = "lab-replay"
+path = "src/bin/lab-replay.rs"
+required-features = ["cli"]
+
+[[bin]]
+name = "lab-budget"
+path = "src/bin/lab-budget.rs"
+required-features = ["cli", "experiment-budgeted-search"]
+
+[[bin]]
+name = "lab-bayes"
+path = "src/bin/lab-bayes.rs"
+required-features = ["cli", "experiment-bayesian-cfr"]
+
+[[bin]]
+name = "lab-belief"
+path = "src/bin/lab-belief.rs"
+required-features = ["cli", "experiment-public-belief"]
+
+[[bin]]
+name = "lab-belief-speed"
+path = "src/bin/lab-belief-speed.rs"
+required-features = ["cli", "experiment-growing-belief"]
+
+[[bin]]
+name = "lab-search-quality"
+path = "src/bin/lab-search-quality.rs"
+required-features = ["experiment-search-quality"]
+
+# Experiment: preserve tests while reducing integration-test executable count.
+
+[[test]]
+name = "bundle_search_01"
+path = "tests/bundle_search_01.rs"
+
+[[test]]
+name = "bundle_search_02"
+path = "tests/bundle_search_02.rs"
+
+[[test]]
+name = "prepared_turn"
+path = "tests/prepared_turn.rs"
+
+[[test]]
+name = "borrowed_child_keys"
+path = "tests/borrowed_child_keys.rs"
+
+[[bin]]
+name = "lab-belief-workspace-speed"
+path = "src/bin/lab-belief-workspace-speed.rs"
+required-features = ["cli", "experiment-belief-workspace"]
+
+[[bin]]
+name = "lab-belief-workspace"
+path = "src/bin/lab-belief-workspace.rs"
+required-features = ["cli", "experiment-belief-workspace"]
+
+[[test]]
+name = "owned_transitions"
+path = "tests/owned_transitions.rs"
+required-features = ["experiment-owned-transitions-observer"]
