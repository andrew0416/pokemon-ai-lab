-    check_turn_parent(state)?;
-    let normalized = [
-        check_side(state, ruleset, SideId::One, &choices[0])?,
-        check_side(state, ruleset, SideId::Two, &choices[1])?,
-    ];
-    check_turn_support(state)?;
