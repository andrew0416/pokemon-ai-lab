new file mode 100644
index 0000000..7629cd8
--- /dev/null
+++ b/.github/workflows/engine-s26e-parallel.yml
@@ -0,0 +1,78 @@
+name: S26e parallel transitions parity and speed
+on:
+  push:
+    branches: [codex/s26e-parallel-20261003]
+permissions:
+  contents: read
+concurrency:
+  group: s26e-parallel
+  cancel-in-progress: false
+env:
+  CARGO_TERM_COLOR: never
+  CARGO_INCREMENTAL: "0"
+  CARGO_BUILD_JOBS: "2"
+  CARGO_TARGET_DIR: ${{ github.workspace }}/target-s25
+  CARGO_PROFILE_DEV_DEBUG: "0"
+  CARGO_PROFILE_TEST_DEBUG: "0"
+  CARGO_PROFILE_RELEASE_DEBUG: "0"
+  RUSTFLAGS: "-C target-cpu=x86-64"
+  RUST_MIN_STACK: "16777216"
+  RUST_TEST_THREADS: "1"
+  RAYON_NUM_THREADS: "1"
+  OPENBLAS_NUM_THREADS: "1"
+  OMP_NUM_THREADS: "1"
+  PYTHONUTF8: "1"
+jobs:
+  compare:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: dtolnay/rust-toolchain@1.98.1
+        with:
+          components: clippy
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - uses: Swatinem/rust-cache@v2
+        with:
+          prefix-key: engine-search-quality-deps-v1
+          workspaces: engine -> ../target-s25
+          cache-workspace-crates: false
+          cache-bin: false
+      - name: Independent oracle dependencies
+        run: python -m pip install numpy==2.2.6 scipy==1.15.3
+      - name: Correctness and portable release binary
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p s26e-parallel-results
+          cd engine
+          cargo test --locked -p lab-engine --lib --features experiment-owned-endings 2>&1 | tee ../s26e-parallel-results/core.log
+          cargo test --locked -p lab-search --test owned_transitions --features experiment-parallel-transitions,experiment-owned-transitions-observer -- --nocapture 2>&1 | tee ../s26e-parallel-results/owned.log
+          cargo test --locked -p lab-search --lib --features experiment-parallel-transitions,experiment-response-sweeps,experiment-search-quality 2>&1 | tee ../s26e-parallel-results/on.log
+          cargo test --locked -p lab-search --bin lab-belief-workspace --features experiment-parallel-transitions 2>&1 | tee ../s26e-parallel-results/cli.log
+          cargo test --locked -p lab-search --lib 2>&1 | tee ../s26e-parallel-results/off.log
+          cargo check --locked -p lab-search --bin lab-belief-workspace --bin lab-belief-workspace-speed --features experiment-belief-workspace 2>&1 | tee ../s26e-parallel-results/fallback-build.log
+          cargo check --locked -p lab-search --lib --no-default-features --features experiment-parallel-transitions 2>&1 | tee ../s26e-parallel-results/library.log
+          cargo clippy --locked -p lab-search --lib --bin lab-belief-workspace --bin lab-belief-workspace-speed --test owned_transitions --features experiment-parallel-transitions,experiment-owned-transitions-observer -- -D warnings 2>&1 | tee ../s26e-parallel-results/clippy.log
+          cargo build --locked -p lab-search --bin lab-belief-workspace --features experiment-parallel-transitions 2>&1 | tee ../s26e-parallel-results/debug-build.log
+          cargo build --locked --release -p lab-search --bin lab-belief-workspace-speed --features experiment-parallel-transitions 2>&1 | tee ../s26e-parallel-results/release-build.log
+          git rev-parse HEAD > ../s26e-parallel-results/source-sha.txt
+          rustc --version > ../s26e-parallel-results/rustc.txt
+      - name: Independent full-tree LP certificates
+        run: python -B engine/benchmarks/s26_tree/check.py --binary target-s25/debug/lab-belief-workspace --out s26e-parallel-results/tree-lp
+      - name: Independent growing-tree LP certificates and rollback
+        run: python -B engine/benchmarks/s26_tree/growing_check.py --binary target-s25/debug/lab-belief-workspace --out s26e-parallel-results/growing-lp
+      - name: Exact same-work paired comparison
+        run: python -B engine/benchmarks/s26_parallel/run.py --binary target-s25/release/lab-belief-workspace-speed --out s26e-parallel-results/paired
+      - name: Preserve evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: s26e-parallel-${{ github.run_id }}-${{ github.run_attempt }}
+          path: s26e-parallel-results/
+          if-no-files-found: error
+          retention-days: 30
