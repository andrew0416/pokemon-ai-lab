+          rustc --edition=2021 -C opt-level=2 -C target-cpu=x86-64 benchmarks/s26_boundary/cpu_probe.rs -o "$RUNNER_TEMP/s26k-bins/cpu-probe"
+          git rev-parse HEAD > ../s26k-boundary-results/source-sha.txt
+          rustc --version > ../s26k-boundary-results/rustc.txt
+          sha256sum "$RUNNER_TEMP/s26k-bins/"* > ../s26k-boundary-results/binaries.sha256
+      - name: Independent pipeline exhaustive BR and LP certificates
+        run: python -B engine/benchmarks/s26_boundary/contract_check.py --binary target-s25/debug/lab-belief-workspace --out s26k-boundary-results/pipeline-lp --require-lp
+      - name: Uninstrumented full-result witnesses
+        run: python -B engine/benchmarks/s26_boundary/run.py --binary "$RUNNER_TEMP/s26k-bins/speed" --out s26k-boundary-results/check --mode check
+      - name: Instrumentation counters and cross-build parity
+        run: python -B engine/benchmarks/s26_boundary/run.py --binary "$RUNNER_TEMP/s26k-bins/profile" --out s26k-boundary-results/profile-check --mode profile-check --parity s26k-boundary-results/check/summary.json
+      - name: Every intermediate snapshot shadow checks
+        run: python -B engine/benchmarks/s26_boundary/run.py --binary "$RUNNER_TEMP/s26k-bins/audit" --out s26k-boundary-results/audit-check --mode check --parity s26k-boundary-results/check/summary.json
+      - name: Uninstrumented A-A and boundary comparison
+        run: python -B engine/benchmarks/s26_boundary/run.py --binary "$RUNNER_TEMP/s26k-bins/speed" --out s26k-boundary-results/paired --mode speed --parity s26k-boundary-results/check/summary.json
+      - name: Same-runner pinned version comparisons and true A-A
+        run: python -B engine/benchmarks/s26_boundary/cross_version.py --s24 "$RUNNER_TEMP/s26k-bins/s24-speed" --s25 "$RUNNER_TEMP/s26k-bins/s25-speed" --current "$RUNNER_TEMP/s26k-bins/speed" --parity s26k-boundary-results/check/summary.json --out s26k-boundary-results/cross-version
+      - name: Separate instrumented phase diagnostics
+        run: python -B engine/benchmarks/s26_boundary/run.py --binary "$RUNNER_TEMP/s26k-bins/profile" --out s26k-boundary-results/profile --mode profile --parity s26k-boundary-results/check/summary.json
+      - name: Ephemeral runner CPU emulator
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends qemu-user time
+      - name: Fresh-process allocation and RSS measurements
+        run: python -B engine/benchmarks/s26_boundary/memory_run.py --binary "$RUNNER_TEMP/s26k-bins/memory" --out s26k-boundary-results/memory --parity s26k-boundary-results/check/summary.json
+      - name: Rotated sand RSS repetition in plain and instrumented binaries
+        run: python -B engine/benchmarks/s26_boundary/rss_repeat.py --old-speed "$RUNNER_TEMP/s26k-bins/s25-speed" --old-memory "$RUNNER_TEMP/s26k-bins/s25-memory" --speed "$RUNNER_TEMP/s26k-bins/speed" --memory "$RUNNER_TEMP/s26k-bins/memory" --parity s26k-boundary-results/check/summary.json --out s26k-boundary-results/rss-repeat
+      - name: Non-AVX2 emulated execution and scalar fallback
+        run: python -B engine/benchmarks/s26_boundary/portability.py --binary "$RUNNER_TEMP/s26k-bins/speed" --scalar "$RUNNER_TEMP/s26k-bins/scalar" --probe "$RUNNER_TEMP/s26k-bins/cpu-probe" --out s26k-boundary-results/portability
+      - name: Preserve evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: s26k-boundary-${{ github.run_id }}-${{ github.run_attempt }}
+          path: s26k-boundary-results/
+          if-no-files-found: error
