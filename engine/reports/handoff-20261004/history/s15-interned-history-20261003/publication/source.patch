+fn result(r: Result<growing::ResultTree, bayesian::Error>) -> String {
+    match r {
+        Err(e) => format!("error:{e:?}"),
+        Ok(r) => format!(
+            "{:?}|{:?}|{:?}|{:?}|{:?}|{}|{}|{}",
+            r.built.tree,
+            r.built.stats,
+            r.solution,
