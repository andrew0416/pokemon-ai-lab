+          cargo clippy --locked -p lab-search --lib --bin lab-belief --features experiment-growing-belief,experiment-response-sweeps,experiment-search-quality -- -D warnings 2>&1 | tee ../s26c-results/clippy.log
+          cargo build --locked -p lab-search --bin lab-belief --bin lab-bayes --features experiment-growing-belief 2>&1 | tee ../s26c-results/build.log
+          git rev-parse HEAD > ../s26c-results/source-sha.txt
+          rustc --version > ../s26c-results/rustc.txt
+      - name: Independent extensive-game LP and information-constrained best responses
+        run: python -B engine/benchmarks/s26_tree/check.py --binary target-s25/debug/lab-belief --out s26c-results/tree-lp
+      - name: Independent growing snapshots and exhaustive reference
+        run: python -B engine/benchmarks/s26_tree/growing_check.py --binary target-s25/debug/lab-belief --out s26c-results/growing-lp
+      - name: Previous Bayesian matrix LP regression
