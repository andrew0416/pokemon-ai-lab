+#[test]
+fn incomplete_root_never_returns_a_strategy() {
+    assert!(search(
+        &Game::new(),
+        &seeds(),
+        Limits {
+            max_transitions: 7,
+            ..Limits::default()
+        },
+        config(100),
+        &Uniform
+    )
+    .unwrap_err_text()
+    .contains("root incomplete"));
+}
+trait ErrText {
+    fn unwrap_err_text(self) -> String;
+}
+impl ErrText for Result<ResultTree, Error> {
+    fn unwrap_err_text(self) -> String {
+        match self {
+            Err(e) => e.0,
+            Ok(_) => panic!("expected error"),
+        }
+    }
+}
