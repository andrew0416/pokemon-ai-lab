+          cargo test --locked -p lab-search --lib --features experiment-growing-belief,experiment-response-sweeps,experiment-search-quality 2>&1 | tee ../s26c-results/on.log
+          cargo test --locked -p lab-search --bin lab-belief --bin lab-bayes --features experiment-growing-belief 2>&1 | tee ../s26c-results/cli.log
+          cargo test --locked -p lab-search --lib 2>&1 | tee ../s26c-results/off.log
