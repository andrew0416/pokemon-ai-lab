+#[derive(Clone, Debug)]
+pub struct Tree {
+    nodes: Vec<Compiled>,
+    root: usize,
+    order: Vec<usize>,
+    information: Vec<Information>,
+    scale: f64,
+    pub(crate) worlds: Vec<String>,
+    pub(crate) public_keys: Vec<String>,
+    pub(crate) private_keys: Vec<String>,
+    pub(crate) boundaries: Vec<Boundary>,
