+name: S26i detailed admission, memory, snapshots and portability
+on:
+  push:
+    branches: [codex/s26i-audit-20261003]
+permissions:
+  contents: read
+concurrency:
+  group: s26i-audit
+  cancel-in-progress: false
+env:
+  CARGO_TERM_COLOR: never
+  CARGO_INCREMENTAL: "0"
+  CARGO_BUILD_JOBS: "2"
+  CARGO_TARGET_DIR: ${{ github.workspace }}/target-s25
+  CARGO_PROFILE_DEV_DEBUG: "0"
+  CARGO_PROFILE_TEST_DEBUG: "0"
+  CARGO_PROFILE_RELEASE_DEBUG: "0"
+  RUSTFLAGS: "-C target-cpu=x86-64"
+  RUST_MIN_STACK: "16777216"
+  RUST_TEST_THREADS: "1"
+  RAYON_NUM_THREADS: "1"
+  OPENBLAS_NUM_THREADS: "1"
+  OMP_NUM_THREADS: "1"
+  PYTHONUTF8: "1"
+  PYTHONHASHSEED: "0"
+jobs:
+  compare:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 35
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: dtolnay/rust-toolchain@1.98.1
+        with:
+          components: clippy
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - uses: Swatinem/rust-cache@v2
+        with:
+          prefix-key: engine-search-quality-deps-v1
+          workspaces: engine -> ../target-s25
+          cache-workspace-crates: false
+          cache-bin: false
+      - name: Independent oracle dependencies
+        run: python -m pip install numpy==2.2.6 scipy==1.15.3
+      - name: Correctness, fallback, and separate portable release builds
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p s26i-audit-results "$RUNNER_TEMP/s26i-bins"
+          cd engine
+          cargo test --locked -p lab-search --lib --features experiment-phase-cost,experiment-snapshot-audit,experiment-response-sweeps,experiment-search-quality 2>&1 | tee ../s26i-audit-results/instrumented-tests.log
+          cargo test --locked -p lab-search --lib --features experiment-growth-pipeline,experiment-response-sweeps,experiment-search-quality 2>&1 | tee ../s26i-audit-results/uninstrumented-tests.log
+          cargo test --locked -p lab-search --lib 2>&1 | tee ../s26i-audit-results/default-off.log
+          cargo check --locked -p lab-search --lib --no-default-features --features experiment-phase-cost 2>&1 | tee ../s26i-audit-results/no-default.log
+          cargo check --locked -p lab-search --bin lab-belief-workspace --features experiment-belief-workspace 2>&1 | tee ../s26i-audit-results/fallback.log
+          cargo clippy --locked -p lab-search --lib --bin lab-phase-speed --features experiment-phase-cost -- -D warnings 2>&1 | tee ../s26i-audit-results/instrumented-clippy.log
+          cargo clippy --locked -p lab-search --lib --bin lab-phase-speed --features experiment-growth-pipeline -- -D warnings 2>&1 | tee ../s26i-audit-results/uninstrumented-clippy.log
+          cargo build --locked -p lab-search --bin lab-belief-workspace --features experiment-snapshot-audit 2>&1 | tee ../s26i-audit-results/oracle-build.log
+          cargo build --locked --release -p lab-search --bin lab-phase-speed --features experiment-growth-pipeline 2>&1 | tee ../s26i-audit-results/speed-build.log
+          cp "$CARGO_TARGET_DIR/release/lab-phase-speed" "$RUNNER_TEMP/s26i-bins/speed"
+          cargo build --locked --release -p lab-search --bin lab-phase-speed --features experiment-phase-cost 2>&1 | tee ../s26i-audit-results/profile-build.log
+          cp "$CARGO_TARGET_DIR/release/lab-phase-speed" "$RUNNER_TEMP/s26i-bins/profile"
+          cargo build --locked --release -p lab-search --bin lab-phase-speed --features experiment-snapshot-audit 2>&1 | tee ../s26i-audit-results/audit-build.log
+          cp "$CARGO_TARGET_DIR/release/lab-phase-speed" "$RUNNER_TEMP/s26i-bins/audit"
+          cargo build --locked --release -p lab-search --bin lab-phase-speed --features experiment-allocation-audit 2>&1 | tee ../s26i-audit-results/memory-build.log
+          cp "$CARGO_TARGET_DIR/release/lab-phase-speed" "$RUNNER_TEMP/s26i-bins/memory"
+          cargo clippy --locked -p lab-search --lib --bin lab-phase-speed --features experiment-allocation-audit,experiment-snapshot-audit -- -D warnings 2>&1 | tee ../s26i-audit-results/audit-clippy.log
+          cargo build --locked --release -p lab-search --bin lab-belief-workspace --features experiment-belief-workspace 2>&1 | tee ../s26i-audit-results/scalar-build.log
+          cp "$CARGO_TARGET_DIR/release/lab-belief-workspace" "$RUNNER_TEMP/s26i-bins/scalar"
+          rustc --edition=2021 -C opt-level=2 -C target-cpu=x86-64 benchmarks/s26_audit/cpu_probe.rs -o "$RUNNER_TEMP/s26i-bins/cpu-probe"
+          git rev-parse HEAD > ../s26i-audit-results/source-sha.txt
+          rustc --version > ../s26i-audit-results/rustc.txt
+          sha256sum "$RUNNER_TEMP/s26i-bins/"* > ../s26i-audit-results/binaries.sha256
+      - name: Independent pipeline exhaustive BR and LP certificates
+        run: python -B engine/benchmarks/s26_audit/contract_check.py --binary target-s25/debug/lab-belief-workspace --out s26i-audit-results/pipeline-lp --require-lp
+      - name: Uninstrumented full-result witnesses
+        run: python -B engine/benchmarks/s26_audit/run.py --binary "$RUNNER_TEMP/s26i-bins/speed" --out s26i-audit-results/check --mode check
+      - name: Instrumentation counters and cross-build parity
+        run: python -B engine/benchmarks/s26_audit/run.py --binary "$RUNNER_TEMP/s26i-bins/profile" --out s26i-audit-results/profile-check --mode profile-check --parity s26i-audit-results/check/summary.json
+      - name: Every intermediate snapshot shadow checks
+        run: python -B engine/benchmarks/s26_audit/run.py --binary "$RUNNER_TEMP/s26i-bins/audit" --out s26i-audit-results/audit-check --mode check --parity s26i-audit-results/check/summary.json
+      - name: Uninstrumented A-A and many-snapshot confirmation
+        run: python -B engine/benchmarks/s26_audit/run.py --binary "$RUNNER_TEMP/s26i-bins/speed" --out s26i-audit-results/paired --mode speed --parity s26i-audit-results/check/summary.json
+      - name: Separate instrumented phase diagnostics
+        run: python -B engine/benchmarks/s26_audit/run.py --binary "$RUNNER_TEMP/s26i-bins/profile" --out s26i-audit-results/profile --mode profile --parity s26i-audit-results/check/summary.json
+      - name: Fresh-process allocation and RSS measurements
+        run: python -B engine/benchmarks/s26_audit/memory_run.py --binary "$RUNNER_TEMP/s26i-bins/memory" --out s26i-audit-results/memory --parity s26i-audit-results/check/summary.json
+      - name: Ephemeral runner CPU emulator
+        run: |
+          sudo apt-get update -qq
+          sudo apt-get install -y --no-install-recommends qemu-user time
+      - name: Non-AVX2 emulated execution and scalar fallback
+        run: python -B engine/benchmarks/s26_audit/portability.py --binary "$RUNNER_TEMP/s26i-bins/speed" --scalar "$RUNNER_TEMP/s26i-bins/scalar" --probe "$RUNNER_TEMP/s26i-bins/cpu-probe" --out s26i-audit-results/portability
+      - name: Preserve evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: s26i-audit-${{ github.run_id }}-${{ github.run_attempt }}
+          path: s26i-audit-results/
+          if-no-files-found: error
+          retention-days: 30
