+        assert_eq!(ps.len(), 1);
+        Position {
+            state: ps[0].state.clone(),
+            suspension: None,
+        }
+    };
+    let a = load(&v);
+    v["p2"]["team"]
+        .as_array_mut()
+        .unwrap()
+        .push(mon("Clefable"));
+    v["p2"]["order"] = serde_json::json!("1234");
+    let b = load(&v);
+    let worlds = [ew("three", a), ew("four", b)];
+    let result = engine::one_turn(
+        &worlds,
+        SideId::One,
+        Ruleset::CHAMPIONS_MC,
