+            limit=PLAN['completion_diagnostic_seconds']
+            process,raw=trial(out/('completion-'+mode),case,mode,1,limit)
+            ready=next((r for r in raw if r.get('kind')=='ready'),None)
+            assert ready and ready['actions']==menu
+            scored=score_trial(raw,reference,[limit],PLAN['work_checkpoints'])
+            if process['exit_code']!=0 and process['watchdog']!='deadline': scored['valid']=False
+            diagnostics.append(dict(mode=mode,process=process,done=[r for r in raw if r.get('kind')=='done'],**scored))
+    result=dict(case=case,source_sha=manifest['source_sha'],package_manifest_sha256=digest(PACKAGE/'manifest.json'),
+        reference=ref_record,trials=trials,diagnostics=diagnostics,valid=all(t['valid'] for t in trials+diagnostics))
+    write(out/'result.json',result)
