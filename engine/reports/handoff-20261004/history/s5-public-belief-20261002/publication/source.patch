+        assert_eq!(r["finite_game_gap"], 0.);
+        v["solver"] = json!({"iterations":0});
+        assert!(request(&v, Path::new(".")).is_err());
+        let v = json!({"mode":"engine","worlds":[]});
+        assert!(request(&v, Path::new("."))
+            .err()
+            .unwrap()
+            .contains("observation_model"));
+    }
+}
