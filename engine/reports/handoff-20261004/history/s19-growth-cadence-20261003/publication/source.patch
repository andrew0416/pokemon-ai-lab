+            &domain,
+            &seeds,
+            limits,
+            settings.growth,
+            &builder::growing::Uniform,
+            settings.storage,
+        );
+    }
+    builder::growing::reuse::search(
+        &domain,
+        &seeds,
+        limits,
+        settings.growth,
+        &builder::growing::Uniform,
+        settings.storage,
+    )
+}
