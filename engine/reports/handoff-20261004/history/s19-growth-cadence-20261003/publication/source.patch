+#[cfg(feature = "experiment-belief-workspace")]
+fn growing_storage<
+    const N: usize,
+    E: Evaluator<N> + ?Sized,
+    const OWNED: bool,
+    const SHARED: bool,
+    const INCREMENTAL: bool,
+>(
+    worlds: &[EngineWorld<N>],
+    us: SideId,
+    ruleset: Ruleset,
+    evaluator: &E,
+    knowledge: &Knowledge,
