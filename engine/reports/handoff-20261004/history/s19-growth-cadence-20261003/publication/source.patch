diff --git a/.github/workflows/engine-s26e-cadence.yml b/.github/workflows/engine-s26e-cadence.yml
new file mode 100644
index 0000000..9aac2bf
--- /dev/null
+++ b/.github/workflows/engine-s26e-cadence.yml
@@ -0,0 +1,80 @@
+name: S26e growth solve cadence parity and speed
+on:
+  push:
+    branches: [codex/s26e-cadence-20261003]
+permissions:
+  contents: read
+concurrency:
+  group: s26e-cadence
+  cancel-in-progress: false
+env:
+  CARGO_TERM_COLOR: never
+  CARGO_INCREMENTAL: "0"
+  CARGO_BUILD_JOBS: "2"
+  CARGO_TARGET_DIR: ${{ github.workspace }}/target-s25
+  CARGO_PROFILE_DEV_DEBUG: "0"
+  CARGO_PROFILE_TEST_DEBUG: "0"
+  CARGO_PROFILE_RELEASE_DEBUG: "0"
+  RUSTFLAGS: "-C target-cpu=x86-64"
+  RUST_MIN_STACK: "16777216"
+  RUST_TEST_THREADS: "1"
+  RAYON_NUM_THREADS: "1"
+  OPENBLAS_NUM_THREADS: "1"
+  OMP_NUM_THREADS: "1"
+  PYTHONUTF8: "1"
+jobs:
+  compare:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+      - uses: dtolnay/rust-toolchain@1.98.1
+        with:
+          components: clippy
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+      - uses: Swatinem/rust-cache@v2
+        with:
+          prefix-key: engine-search-quality-deps-v1
+          workspaces: engine -> ../target-s25
+          cache-workspace-crates: false
+          cache-bin: false
+      - name: Independent oracle dependencies
+        run: python -m pip install numpy==2.2.6 scipy==1.15.3
+      - name: Correctness and portable release binary
+        shell: bash
+        run: |
+          set -euo pipefail
+          mkdir -p s26e-cadence-results
+          cd engine
+          cargo test --locked -p lab-engine --lib --features experiment-owned-endings 2>&1 | tee ../s26e-cadence-results/core.log
+          cargo test --locked -p lab-search --test owned_transitions --features experiment-growth-cadence,experiment-owned-transitions-observer -- --nocapture 2>&1 | tee ../s26e-cadence-results/owned.log
+          cargo test --locked -p lab-search --lib --features experiment-growth-cadence,experiment-response-sweeps,experiment-search-quality 2>&1 | tee ../s26e-cadence-results/on.log
+          cargo test --locked -p lab-search --bin lab-belief-workspace --features experiment-growth-cadence 2>&1 | tee ../s26e-cadence-results/cli.log
+          cargo test --locked -p lab-search --lib 2>&1 | tee ../s26e-cadence-results/off.log
+          cargo check --locked -p lab-search --bin lab-belief-workspace --bin lab-belief-workspace-speed --features experiment-belief-workspace 2>&1 | tee ../s26e-cadence-results/fallback-build.log
+          cargo check --locked -p lab-search --lib --no-default-features --features experiment-growth-cadence 2>&1 | tee ../s26e-cadence-results/library.log
+          cargo clippy --locked -p lab-search --lib --bin lab-belief-workspace --bin lab-belief-workspace-speed --test owned_transitions --features experiment-growth-cadence,experiment-owned-transitions-observer -- -D warnings 2>&1 | tee ../s26e-cadence-results/clippy.log
+          cargo build --locked -p lab-search --bin lab-belief-workspace --features experiment-growth-cadence 2>&1 | tee ../s26e-cadence-results/debug-build.log
+          cargo build --locked --release -p lab-search --bin lab-belief-workspace-speed --features experiment-growth-cadence 2>&1 | tee ../s26e-cadence-results/release-build.log
+          git rev-parse HEAD > ../s26e-cadence-results/source-sha.txt
+          rustc --version > ../s26e-cadence-results/rustc.txt
+      - name: Independent full-tree LP certificates
+        run: python -B engine/benchmarks/s26_tree/check.py --binary target-s25/debug/lab-belief-workspace --out s26e-cadence-results/tree-lp
+      - name: Independent growing-tree LP certificates and rollback
+        run: python -B engine/benchmarks/s26_tree/growing_check.py --binary target-s25/debug/lab-belief-workspace --out s26e-cadence-results/growing-lp
+      - name: Cadence independent LP and pending-batch rollback
+        run: python -B engine/benchmarks/s26_cadence/check.py --binary target-s25/debug/lab-belief-workspace --out s26e-cadence-results/cadence-lp
+      - name: Same-work control and same finite-game comparison
+        run: python -B engine/benchmarks/s26_cadence/run.py --binary target-s25/release/lab-belief-workspace-speed --out s26e-cadence-results/paired
+      - name: Preserve evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: s26e-cadence-${{ github.run_id }}-${{ github.run_attempt }}
+          path: s26e-cadence-results/
+          if-no-files-found: error
+          retention-days: 30
diff --git a/engine/benchmarks/s26_cadence/check.py b/engine/benchmarks/s26_cadence/check.py
new file mode 100644
index 0000000..e903899
--- /dev/null
+++ b/engine/benchmarks/s26_cadence/check.py
@@ -0,0 +1,60 @@
+"""Independent normal-form LP for cadence snapshots, with pending-batch rollback.
+
+24 existing generated games; 168 certificates across full and cadence2/4 budgets.
+This is not 168 distinct new games, nor a win-rate test.
+"""
+from pathlib import Path
+import argparse,copy,hashlib,json,random,subprocess,sys
+sys.path.insert(0,str(Path(__file__).resolve().parent.parent/'s26_tree'))
+from growing_check import generated,canonical,certificate
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('--binary',type=Path,required=True);p.add_argument('--out',type=Path,required=True);a=p.parse_args()
+    a.out.mkdir(parents=True,exist_ok=False);binary=a.binary.resolve();rng=random.Random(26100227);records=[]
+    def run(name,request,ok=True):
+        path=a.out/(name+'-request.json');path.write_text(json.dumps(request),encoding='utf-8')
+        child=subprocess.run([str(binary),str(path.resolve())],capture_output=True,timeout=90)
+        (a.out/(name+'-result.json')).write_bytes(child.stdout);(a.out/(name+'-stderr.txt')).write_bytes(child.stderr)
+        assert (child.returncode==0)==ok,(name,child.stderr.decode())
+        return json.loads(child.stdout) if ok else None
+    for case in range(24):
+        request=generated(rng,case);name=f'case-{case:02}'
+        full=run(name+'-full',request);ref=certificate(full);records.append(dict(case=name+'-full',**ref))
+        for cadence in [2,4]:
+            for budget in [1,2,99]:
+                q=copy.deepcopy(request);q['growth']=dict(cadence=cadence,max_expansions=budget,max_walks=1000,seed=case+1)
+                tag=name+f'-cadence{cadence}-budget{budget}';r=run(tag,q);cert=certificate(r);g=r['metadata']['growth']
+                assert g['solve_cadence']==cadence
+                assert r['surrogate_converged']==(r['finite_game_gap']<=q['solver']['tolerance'])
+                assert r['converged']==(g['horizon_complete'] and r['surrogate_converged'])
+                assert g['attempted_transitions']==g['committed_transitions']
+                expected=3 if budget==99 else budget
+                assert g['committed_expansions']==expected and g['frontier_public_groups']==3-expected
+                if budget==99:
+                    assert g['horizon_complete'] and r['converged'] and g['solves']==2
+                    assert canonical(r['oracle_tree'])==canonical(full['oracle_tree'])
+                    assert {i['key']:i['probabilities'] for i in r['policies']}=={i['key']:i['probabilities'] for i in full['policies']}
+                    assert abs(cert['lp_value']-ref['lp_value'])<1e-8
+                    assert g['attempted_transitions']==full['metadata']['transitions']
+                else:
+                    assert not g['horizon_complete'] and r['full_horizon_gap'] is None
+                    assert r['certificate_scope']=='current-fixed-leaf-surrogate-only'
+                records.append(dict(case=tag,**cert))
+    q=generated(rng,2);q['growth']=dict(max_expansions=1,seed=1,cadence=4)
+    root=run('rollback-root',q)
+    q['growth'].update(max_expansions=2,cadence=1);one=run('rollback-one-group',q)
+    cap=one['metadata']['growth']['attempted_transitions']+1
+    q['growth'].update(max_expansions=100,cadence=4);q['limits']['max_transitions']=cap
+    r=run('rollback-pending-complete-group-plus-partial',q)
+    assert r['policies']==root['policies'] and canonical(r['oracle_tree'])==canonical(root['oracle_tree'])
+    g=r['metadata']['growth'];assert g['attempted_transitions']==cap and g['committed_expansions']==1 and g['solves']==1
+    assert g['stop']=='TransitionLimit' and not g['horizon_complete'] and r['full_horizon_gap'] is None
+    certificate(r)
+    q['limits']['max_transitions']=root['metadata']['growth']['attempted_transitions']-1;run('incomplete-root',q,False)
+    q['growth']['cadence']=3;run('invalid-cadence',q,False)
+    summary=dict(passed=len(records),generated_games=24,lp_certificates=len(records),cadences=[2,4],full_growth_matches=48,
+        pending_batch_rollback=True,root_rejection=True,invalid_cadence=True,performance=False,
+        cases=records,binary_sha256=hashlib.sha256(binary.read_bytes()).hexdigest())
+    (a.out/'summary.json').write_text(json.dumps(summary,indent=2)+'\n',encoding='utf-8')
+    print(json.dumps({k:v for k,v in summary.items() if k!='cases'}))
+if __name__=='__main__':main()
