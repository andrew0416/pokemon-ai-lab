+            nodes,
+            root,
+            order,
+            information,
+            scale: scale.max(f64::MIN_POSITIVE),
+            worlds: Vec::new(),
+            public_keys: Vec::new(),
+            private_keys: Vec::new(),
+            boundaries: Vec::new(),
