+        let mut order = Vec::new();
+        let mut stack = vec![(root, [Vec::new(), Vec::new()], 0usize)];
+        while let Some((id, sequences, depth)) = stack.pop() {
+            if id >= nodes.len() || seen[id] || depth > 512 {
+                return Err(Error(
