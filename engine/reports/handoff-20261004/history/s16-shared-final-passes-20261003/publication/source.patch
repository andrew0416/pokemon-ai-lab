-        solution: solved,
-        stop,
-        frontier_histories: growing.frontier.values().map(Vec::len).sum(),
-        frontier_public_groups: growing.frontier.len(),
-        horizon_complete: growing.frontier.is_empty(),
-        work,
-    })
-}
