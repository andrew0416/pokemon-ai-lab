+                    if !v.is_finite() || v.abs() > f64::MAX / 8. {
+                        return Err(Error("invalid terminal value".into()));
+                    }
+                    scale = scale.max(v.abs());
+                    Compiled::Terminal(v)
+                }
+                Node::Chance(edges) => {
+                    if edges.is_empty()
