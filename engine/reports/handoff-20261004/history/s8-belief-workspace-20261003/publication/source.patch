+fn multiply(a: f64, b: f64) -> Result<f64, Error> {
+    let v = a * b;
+    if a > 0. && b > 0. && v == 0. {
+        return Err(Error(
+            "positive history reach underflow; history was not dropped".into(),
+        ));
+    }
+    Ok(v)
