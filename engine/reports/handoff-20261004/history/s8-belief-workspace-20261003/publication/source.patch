+pub trait Prior {
+    fn weights(&self, information: &Information) -> Vec<f64>;
+}
+pub struct Uniform;
+impl Prior for Uniform {
+    fn weights(&self, information: &Information) -> Vec<f64> {
+        vec![1.; information.actions.len()]
