+        for (id, out) in result.iter_mut().enumerate() {
+            if out.reach > 0. {
+                out.posterior = Some(masses[id].iter().map(|v| v / out.reach).collect());
+                for (w, v) in out.world_values.iter_mut().enumerate() {
+                    if masses[id][w] > 0. {
+                        *v = Some(sums[id][w] * self.scale);
+                    }
+                }
+                for (_, r) in &mut out.histories {
+                    *r /= out.reach;
+                }
+            }
+        }
+        Ok(result)
+    }
+}
