+    pub max_expansions: usize,
+    /// Selection walks, including walks ending in an already terminal/horizon node.
+    pub max_walks: usize,
+    /// Dimensionless: action values are scaled by the current tree's utility scale.
+    pub exploration: f64,
+    pub seed: u64,
+    pub solver: CfrConfig,
