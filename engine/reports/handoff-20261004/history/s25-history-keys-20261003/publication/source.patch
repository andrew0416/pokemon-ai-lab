+        search: ResultTree {
+            built: Built {
+                tree: t,
+                stats: committed.0,
+            },
+            solution: solved,
+            stop,
+            frontier_histories: committed.1,
+            frontier_public_groups: committed.2,
+            horizon_complete: committed.2 == 0,
+            work,
