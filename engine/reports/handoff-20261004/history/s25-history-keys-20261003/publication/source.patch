-        ((z ^ (z >> 31)) >> 11) as f64 * (1. / ((1u64 << 53) as f64))
-    }
-    fn sample(&mut self, weights: &[f64]) -> usize {
-        let mut x = self.unit();
-        for (i, &p) in weights.iter().enumerate() {
-            if x < p {
-                return i;
-            }
-            x -= p;
-        }
-        weights
-            .iter()
-            .rposition(|p| *p > 0.)
-            .expect("validated probability vector")
-    }
-}
